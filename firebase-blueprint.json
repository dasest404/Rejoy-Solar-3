{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and role information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User identifier matching Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user",
          "maxLength": 120,
          "minLength": 1
        },
        "email": {
          "type": "string",
          "description": "Email address of the user",
          "maxLength": 150,
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "Assigned authorization role",
          "enum": [
            "Admin",
            "Sales Manager",
            "Sales Executive",
            "Project Manager",
            "Site Survey Engineer",
            "Site Inspector",
            "Civil Team",
            "Structure Team",
            "Installation Team",
            "Electrical Team",
            "Accountant",
            "HR Manager",
            "Service Manager",
            "Technician",
            "Customer"
          ]
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 30
        },
        "department": {
          "type": "string",
          "description": "Department name",
          "maxLength": 80
        },
        "designation": {
          "type": "string",
          "description": "Job designation",
          "maxLength": 100
        },
        "isFieldWorker": {
          "type": "boolean",
          "description": "Whether employee operates in the field"
        }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Sales lead and inquiry record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique lead identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "description": "Name of prospective client",
          "maxLength": 120,
          "minLength": 1
        },
        "phone": {
          "type": "string",
          "description": "Client contact phone number",
          "maxLength": 30,
          "minLength": 5
        },
        "email": {
          "type": "string",
          "description": "Client email address",
          "maxLength": 150
        },
        "city": {
          "type": "string",
          "description": "City of installation",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Pipeline status of the lead",
          "enum": [
            "NEW",
            "CONTACTED",
            "QUALIFIED",
            "SITE SURVEY",
            "PROPOSAL",
            "NEGOTIATION",
            "WON",
            "LOST"
          ]
        },
        "solarCapacityKw": {
          "type": "number",
          "description": "Capacity of proposed solar system in kW"
        },
        "estimatedValue": {
          "type": "number",
          "description": "Estimated financial deal value"
        },
        "assignedSalespersonId": {
          "type": "string",
          "description": "Assigned sales executive user id",
          "maxLength": 128
        },
        "createdBy": {
          "type": "string",
          "description": "User UID who created the lead",
          "maxLength": 128
        }
      },
      "required": ["id", "customerName", "phone", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client record with site details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Customer identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Customer full or company name",
          "maxLength": 120,
          "minLength": 1
        },
        "phone": {
          "type": "string",
          "description": "Phone number",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "description": "Email address",
          "maxLength": 150
        },
        "city": {
          "type": "string",
          "description": "City",
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "description": "State",
          "maxLength": 100
        },
        "pincode": {
          "type": "string",
          "description": "Postal pincode",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Customer account status",
          "enum": ["ACTIVE", "COMPLETED", "ON HOLD", "CANCELLED"]
        }
      },
      "required": ["id", "name", "phone", "city", "status"]
    },
    "SolarProject": {
      "title": "SolarProject",
      "description": "Solar installation project with milestone workflow",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Project identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectCode": {
          "type": "string",
          "description": "Human readable project code",
          "maxLength": 60
        },
        "customerId": {
          "type": "string",
          "description": "Associated customer ID",
          "maxLength": 128
        },
        "customerName": {
          "type": "string",
          "description": "Associated customer name",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "description": "Project title",
          "maxLength": 150
        },
        "capacityKw": {
          "type": "number",
          "description": "Solar system capacity in kW"
        },
        "totalValue": {
          "type": "number",
          "description": "Total project contracted value"
        },
        "status": {
          "type": "string",
          "description": "Project lifecycle status",
          "enum": [
            "PLANNING",
            "SURVEY",
            "DESIGN & APPROVALS",
            "CIVIL & STRUCTURE",
            "INSTALLATION",
            "TESTING & COMMISSIONING",
            "HANDOVER",
            "COMPLETED",
            "DELAYED",
            "ON HOLD"
          ]
        },
        "currentStageKey": {
          "type": "string",
          "description": "Current active workflow milestone",
          "maxLength": 60
        }
      },
      "required": ["id", "projectCode", "customerId", "title", "status"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Solar system price quotation and bill of materials",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Quotation identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "quotationNumber": {
          "type": "string",
          "description": "Quotation numbering sequence",
          "maxLength": 60
        },
        "customerName": {
          "type": "string",
          "description": "Customer name",
          "maxLength": 120
        },
        "capacityKw": {
          "type": "number",
          "description": "System capacity in kW"
        },
        "grandTotal": {
          "type": "number",
          "description": "Grand total quote amount"
        },
        "status": {
          "type": "string",
          "description": "Quotation approval status",
          "enum": ["DRAFT", "SENT", "ACCEPTED", "REJECTED", "EXPIRED"]
        }
      },
      "required": ["id", "quotationNumber", "customerName", "grandTotal", "status"]
    },
    "ServiceTicket": {
      "title": "ServiceTicket",
      "description": "After-sales O&M maintenance ticket",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Service ticket ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticketNumber": {
          "type": "string",
          "description": "Ticket sequence code",
          "maxLength": 60
        },
        "customerName": {
          "type": "string",
          "description": "Customer reporting issue",
          "maxLength": 120
        },
        "issue": {
          "type": "string",
          "description": "Problem description",
          "maxLength": 500
        },
        "priority": {
          "type": "string",
          "description": "Urgency priority level",
          "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"]
        },
        "status": {
          "type": "string",
          "description": "Ticket resolution state",
          "enum": ["OPEN", "ASSIGNED", "IN PROGRESS", "RESOLVED", "CLOSED"]
        }
      },
      "required": ["id", "ticketNumber", "customerName", "issue", "priority", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Application user profiles and role configuration"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "CRM leads and inquiries"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer master records"
    },
    "/projects/{projectId}": {
      "schema": "SolarProject",
      "description": "Solar installation project records"
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Commercial pricing proposals"
    },
    "/serviceTickets/{ticketId}": {
      "schema": "ServiceTicket",
      "description": "O&M and customer service tickets"
    }
  }
}
